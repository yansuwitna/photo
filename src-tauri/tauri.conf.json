{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photobooth Pro",
  "version": "1.0.0",
  "identifier": "pro.photobooth.kiosk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:8000",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "PHOTOBOOTH PRO",
        "width": 1920,
        "height": 1080,
        "fullscreen": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}